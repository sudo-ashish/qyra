#!/usr/bin/env python3
"""
Qyra Theme Compiler (bin/qyra-theme-gen)
Compiles colors.toml (or colors.json) into generated runtime assets:
  - generated/colors.json (Quickshell Theme.qml)
  - generated/hypr.lua (Hyprland Lua API colors)
  - generated/hyprlock-color.conf (Hyprlock color definitions)
  - generated/color.conf & color.conf (Kitty terminal colors)
  - generated/neovim.lua (Neovim theme specification)
  - generated/vscode.json (VSCode theme specification)
  - generated/icon.theme (Icon theme name)
"""

import sys
import os
import json
from pathlib import Path

try:
    import tomllib
except ImportError:
    import tomli as tomllib


def normalize_hex(color_val: str, default: str = "#000000") -> str:
    if not color_val:
        return default
    c = str(color_val).strip()
    if not c.startswith("#"):
        c = f"#{c}"
    return c.lower()


def hex_to_argb(hex_str: str) -> str:
    h = hex_str.lstrip("#")
    if len(h) == 3:
        h = "".join([c * 2 for c in h])
    return f"0xff{h}"


def load_palette(theme_dir: Path) -> dict:
    toml_path = theme_dir / "colors.toml"
    json_path = theme_dir / "colors.json"

    raw = {}
    if toml_path.is_file():
        with open(toml_path, "rb") as f:
            raw = tomllib.load(f)
    elif json_path.is_file():
        with open(json_path, "r", encoding="utf-8") as f:
            raw = json.load(f)
    else:
        print(f"Error: No colors.toml or colors.json in {theme_dir}", file=sys.stderr)
        return {}

    palette = {k: normalize_hex(v) for k, v in raw.items() if isinstance(v, str) and (v.startswith("#") or len(v) in (3, 6))}
    return palette


def compile_theme(theme_dir: Path) -> bool:
    palette = load_palette(theme_dir)
    if not palette:
        return False

    bg = palette.get("background", palette.get("bg", "#282828"))
    fg = palette.get("foreground", palette.get("fg", "#ebdbb2"))
    accent = palette.get("accent", palette.get("blue", "#7daea3"))
    surface = palette.get("surface", palette.get("lighter_background", palette.get("selection", "#3c3836")))
    border = palette.get("border", palette.get("muted", "#504945"))
    urgent = palette.get("urgent", palette.get("red", "#ea6962"))
    muted = palette.get("muted", palette.get("dark_foreground", "#7c6f64"))

    red = palette.get("red", "#ea6962")
    green = palette.get("green", "#a9b665")
    yellow = palette.get("yellow", "#d8a657")
    blue = palette.get("blue", accent)
    magenta = palette.get("magenta", "#d3869b")
    cyan = palette.get("cyan", "#89b482")

    gen_dir = theme_dir / "generated"
    gen_dir.mkdir(parents=True, exist_ok=True)

    # 1. generated/colors.json (For Quickshell Theme.qml)
    colors_json = {
        "bg": bg,
        "fg": fg,
        "surface": surface,
        "accent": accent,
        "border": border,
        "urgent": urgent,
        "muted": muted,
        "red": red,
        "green": green,
        "yellow": yellow,
        "blue": blue,
        "magenta": magenta,
        "cyan": cyan
    }
    with open(gen_dir / "colors.json", "w", encoding="utf-8") as f:
        json.dump(colors_json, f, indent=2)

    # 2. generated/hypr.lua (Lua table with Hyprland ARGB colors)
    hypr_lua = f"""-- Generated by qyra-theme-gen. DO NOT EDIT MANUALLY.
return {{
    active_border = "{hex_to_argb(accent)}",
    inactive_border = "{hex_to_argb(border)}",
    shadow = "0x66000000",
    bg = "{hex_to_argb(bg)}",
    fg = "{hex_to_argb(fg)}",
    surface = "{hex_to_argb(surface)}"
}}
"""
    with open(gen_dir / "hypr.lua", "w", encoding="utf-8") as f:
        f.write(hypr_lua)

    # 3. generated/hyprlock-color.conf (Hyprlock syntax)
    hyprlock_conf = f"""# Generated by qyra-theme-gen. DO NOT EDIT MANUALLY.
$background = rgb({bg.lstrip('#')})
$foreground = rgb({fg.lstrip('#')})
$accent = rgb({accent.lstrip('#')})
$selection = rgb({surface.lstrip('#')})
$border = rgb({border.lstrip('#')})
$muted = rgb({muted.lstrip('#')})
$red = rgb({red.lstrip('#')})
$green = rgb({green.lstrip('#')})
$yellow = rgb({yellow.lstrip('#')})
"""
    with open(gen_dir / "hyprlock-color.conf", "w", encoding="utf-8") as f:
        f.write(hyprlock_conf)

    # 4. generated/neovim.lua
    theme_name = theme_dir.name
    nvim_lua = f"""-- Generated by qyra-theme-gen.
return {{
    colorscheme = "{theme_name.split('-')[0]}",
}}
"""
    with open(gen_dir / "neovim.lua", "w", encoding="utf-8") as f:
        f.write(nvim_lua)

    # 5. generated/vscode.json
    vscode_json = {
        "workbench.colorTheme": theme_name.replace("-", " ").title()
    }
    with open(gen_dir / "vscode.json", "w", encoding="utf-8") as f:
        json.dump(vscode_json, f, indent=2)

    # 6. generated/icon.theme
    icon_theme = "Papirus-Dark"
    with open(gen_dir / "icon.theme", "w", encoding="utf-8") as f:
        f.write(icon_theme + "\n")

    # 7. color.conf and generated/color.conf (Kitty terminal colors)
    cursor = palette.get("cursor", palette.get("light_foreground", fg))
    sel_fg = palette.get("selection_foreground", fg)
    sel_bg = palette.get("selection_background", palette.get("selection", surface))
    bright_red = palette.get("bright_red", palette.get("color9", red))
    bright_green = palette.get("bright_green", palette.get("color10", green))
    bright_yellow = palette.get("bright_yellow", palette.get("color11", yellow))
    bright_blue = palette.get("bright_blue", palette.get("color12", blue))
    bright_magenta = palette.get("bright_magenta", palette.get("color13", magenta))
    bright_cyan = palette.get("bright_cyan", palette.get("color14", cyan))
    light_fg = palette.get("light_foreground", palette.get("color7", fg))
    bright_fg = palette.get("bright_foreground", palette.get("color15", fg))

    c_keys = [
        ("color0", surface), ("color1", red), ("color2", green), ("color3", yellow),
        ("color4", blue), ("color5", magenta), ("color6", cyan), ("color7", light_fg),
        ("color8", border), ("color9", bright_red), ("color10", bright_green),
        ("color11", bright_yellow), ("color12", bright_blue), ("color13", bright_magenta),
        ("color14", bright_cyan), ("color15", bright_fg)
    ]
    ansi_lines = "\n".join(f"{k} {palette.get(k, fallback)}" for k, fallback in c_keys)

    kitty_conf = f"""# Generated by qyra-theme-gen. DO NOT EDIT MANUALLY.
background {bg}
foreground {fg}
url_color {accent}
cursor {cursor}
selection_foreground {sel_fg}
selection_background {sel_bg}

active_border_color {accent}
inactive_border_color {border}
active_tab_background {sel_bg}
active_tab_foreground {fg}
inactive_tab_background {bg}
inactive_tab_foreground {muted}

{ansi_lines}
"""
    with open(gen_dir / "color.conf", "w", encoding="utf-8") as f:
        f.write(kitty_conf)
    with open(theme_dir / "color.conf", "w", encoding="utf-8") as f:
        f.write(kitty_conf)

    return True


def reload_kitty():
    import subprocess
    try:
        subprocess.run(["pkill", "-SIGUSR1", "-u", str(os.getuid()), "-x", "kitty"], capture_output=True)
    except Exception:
        pass


def resolve_theme_dir(arg: str) -> Path:
    p = Path(arg)
    if p.is_dir():
        return p
    themes_base = Path(os.path.expanduser("~/.config/themes"))
    if (themes_base / arg).is_dir():
        return themes_base / arg
    repo_defaults = Path(__file__).resolve().parent.parent / "defaults" / "themes" / arg
    if repo_defaults.is_dir():
        return repo_defaults
    return p


def main():
    reload = "--reload" in sys.argv
    args = [a for a in sys.argv[1:] if a != "--reload"]
    target = resolve_theme_dir(args[0]) if args else Path(os.path.expanduser("~/.config/themes/current"))
    if not target.is_dir():
        print(f"Error: Theme directory '{target}' does not exist.", file=sys.stderr)
        sys.exit(1)
    if compile_theme(target):
        print(f"Compiled theme in: {target}/generated")
        current_path = Path(os.path.expanduser("~/.config/themes/current"))
        if reload or (current_path.exists() and target.resolve() == current_path.resolve()):
            reload_kitty()
    else:
        sys.exit(1)


if __name__ == "__main__":
    main()
